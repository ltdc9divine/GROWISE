
:root{--bg:#0b100e;--panel:#121a15;--panel2:#17231b;--line:rgba(240,246,238,.12);--text:#f4f5ef;--muted:#a1aaa0;--lime:#b9f66b;--lime2:#d7ffa1;--max:1240px;--radius:22px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(ellipse at 75% 5%,rgba(92,145,67,.13),transparent 36%),radial-gradient(ellipse at 8% 65%,rgba(57,95,64,.09),transparent 32%)}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}button{cursor:pointer}.wrap{width:min(var(--max),calc(100% - 48px));margin:auto}.mono{font-family:"DM Mono",monospace;text-transform:uppercase;letter-spacing:.11em;font-size:11px;color:var(--lime)}.display{font-family:"Space Grotesk",sans-serif;letter-spacing:-.065em;line-height:.95;font-weight:500}.muted{color:var(--muted)}.lime{color:var(--lime)}.eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:22px}.eyebrow:before{content:"";width:22px;height:1px;background:var(--lime)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;border:1px solid transparent;border-radius:999px;padding:14px 19px;font-size:13px;font-weight:700;transition:transform .25s,background .25s,border-color .25s}.btn:hover{transform:translateY(-3px)}.btn-primary{background:var(--lime);color:#142014}.btn-primary:hover{background:var(--lime2)}.btn-ghost{border-color:var(--line);color:var(--text);background:rgba(255,255,255,.025)}.btn-ghost:hover{border-color:rgba(185,246,107,.55)}.arrow{font-size:18px;line-height:0}.nav{height:82px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;background:rgba(11,16,14,.78);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.055)}.nav-inner{display:flex;align-items:center;justify-content:space-between;width:min(var(--max),calc(100% - 48px));margin:auto}.brand{display:flex;align-items:center;gap:10px;font-family:"Space Grotesk";font-weight:700;letter-spacing:-.04em;font-size:21px}.brand-mark{height:34px;width:34px;border-radius:11px;background:var(--lime);color:#142014;display:grid;place-items:center;font-size:20px}.navlinks{display:flex;gap:27px;align-items:center}.navlinks a{font-size:12px;color:#b6beb4;transition:color .2s}.navlinks a:hover,.navlinks a.active{color:var(--lime)}.nav-cta{padding:11px 16px;font-size:12px}.menu-btn{display:none;background:none;border:1px solid var(--line);color:white;border-radius:12px;padding:9px 12px}.page{display:none;animation:pageIn .55s ease both}.page.active{display:block}@keyframes pageIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}.hero{padding:88px 0 70px;min-height:610px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:35px;position:relative}.hero h1{font-size:clamp(58px,8vw,112px);margin:0 0 26px;max-width:760px}.hero p{font-size:16px;line-height:1.8;color:#aeb8ad;max-width:490px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.hero-note{display:flex;gap:13px;align-items:center;margin-top:34px;color:#9aa59a;font-size:11px}.status-dot{height:7px;width:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 14px var(--lime)}.visual{height:470px;position:relative;display:grid;place-items:center;isolation:isolate}.particle-orb{position:absolute;inset:0;width:100%;height:100%;z-index:1;touch-action:pan-y;cursor:grab}.particle-orb:active{cursor:grabbing}.visual .orbit-label,.visual .spark{z-index:2;pointer-events:none}.orb{position:absolute;width:min(34vw,370px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 28% 23%,#e4ffc1 0,#a5eb70 11%,#4d8c48 31%,#1a3825 54%,#0b100e 72%);box-shadow:inset -28px -30px 60px rgba(0,0,0,.7),inset 10px 10px 25px rgba(255,255,255,.22),0 0 100px rgba(142,221,94,.15);animation:float 7s ease-in-out infinite;transform-style:preserve-3d}.orb:before,.orb:after{content:"";position:absolute;inset:-14%;border:1px solid rgba(185,246,107,.45);border-radius:50%;transform:rotateX(67deg) rotateZ(-22deg);box-shadow:0 0 20px rgba(185,246,107,.08)}.orb:after{inset:-24%;transform:rotateX(68deg) rotateZ(34deg);border-color:rgba(230,255,215,.2)}@keyframes float{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-18px) rotate(4deg)}}.orbit-label{position:absolute;border:1px solid var(--line);border-radius:16px;padding:13px 15px;background:rgba(18,26,21,.72);backdrop-filter:blur(16px);box-shadow:0 20px 60px #0003}.orbit-label strong{display:block;font-family:"Space Grotesk";font-size:21px;letter-spacing:-.04em}.orbit-label span{font-size:10px;color:var(--muted)}.label-a{top:62px;left:0}.label-b{right:0;top:165px}.label-c{bottom:50px;left:12%}.spark{position:absolute;width:5px;height:5px;background:var(--lime);border-radius:50%;box-shadow:0 0 15px var(--lime);animation:blink 2s ease-in-out infinite alternate}@keyframes blink{to{opacity:.25;transform:scale(.5)}}.hero-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding:23px 0;color:#8c978b;font-size:11px;gap:20px}.metrics{display:flex;gap:38px}.metric strong{font-family:"Space Grotesk";font-size:20px;color:var(--text);display:block}.metric span{font-size:10px;color:var(--muted)}.section{padding:105px 0}.section-head{display:flex;justify-content:space-between;gap:35px;align-items:end;margin-bottom:44px}.section-head h2{font-size:clamp(38px,5vw,66px);max-width:680px;margin:12px 0 0}.section-head p{max-width:360px;color:var(--muted);font-size:13px;line-height:1.8}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.card{background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));border:1px solid var(--line);border-radius:var(--radius);padding:26px;position:relative;overflow:hidden;transition:transform .35s,border-color .35s,background .35s}.card:hover{transform:translateY(-6px);border-color:rgba(185,246,107,.38);background:linear-gradient(145deg,rgba(185,246,107,.07),rgba(255,255,255,.012))}.card .iconbox{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:rgba(185,246,107,.1);color:var(--lime);font-size:21px;margin-bottom:26px}.card h3{font-family:"Space Grotesk";font-size:22px;letter-spacing:-.04em;margin:0 0 11px}.card p{font-size:13px;line-height:1.8;color:var(--muted);margin:0}.card .card-link{display:inline-flex;margin-top:25px;color:var(--lime);font-size:12px;font-weight:700;gap:8px}.card-num{position:absolute;right:23px;top:23px;color:#5d6a5d;font:11px "DM Mono"}.split{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}.visual-panel{min-height:430px;border-radius:28px;background:radial-gradient(circle at 50% 35%,rgba(185,246,107,.18),transparent 38%),linear-gradient(145deg,#18251b,#0e1510);border:1px solid var(--line);position:relative;overflow:hidden;display:grid;place-items:center}.visual-panel:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(transparent,black,transparent)}.growth-ring{width:220px;height:220px;border:1px solid rgba(185,246,107,.6);border-radius:50%;display:grid;place-items:center;position:relative;box-shadow:0 0 70px rgba(185,246,107,.1)}.growth-ring:before,.growth-ring:after{content:"";position:absolute;inset:-28px;border:1px solid rgba(185,246,107,.25);border-radius:50%;transform:rotateX(65deg)}.growth-ring:after{inset:-60px;transform:rotateX(65deg) rotateZ(50deg)}.growth-core{height:125px;width:125px;border-radius:50%;background:radial-gradient(circle at 30% 20%,#e0ffbc,#8bce5d 25%,#2d5c35 60%,#102016);box-shadow:0 0 50px #a6ee6840}.float-tag{position:absolute;border:1px solid var(--line);background:#111a14dd;padding:12px 15px;border-radius:13px;font-size:11px;backdrop-filter:blur(10px)}.tag1{top:45px;left:25px}.tag2{right:20px;bottom:70px}.tag3{left:38px;bottom:35px;color:var(--lime)}.check-list{display:grid;gap:18px;margin:28px 0}.check-item{display:flex;gap:13px;align-items:flex-start}.check{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:#b9f66b1b;color:var(--lime);flex-shrink:0;font-size:12px}.check-item strong{font-size:13px;display:block;margin-bottom:5px}.check-item span{font-size:12px;line-height:1.7;color:var(--muted)}.cta-band{border-radius:28px;background:var(--lime);color:#152016;padding:45px;display:flex;justify-content:space-between;align-items:center;gap:30px;position:relative;overflow:hidden}.cta-band:after{content:"";position:absolute;width:290px;height:290px;border:1px solid #17281930;border-radius:50%;right:15%;top:-130px;box-shadow:0 0 0 35px #1728190c,0 0 0 70px #1728190c}.cta-band h2{font:500 clamp(30px,4vw,52px)/1 "Space Grotesk";letter-spacing:-.06em;margin:0;max-width:600px;position:relative;z-index:1}.cta-band p{font-size:12px;max-width:420px;line-height:1.7}.btn-dark{background:#152016;color:#f4f5ef;white-space:nowrap;position:relative;z-index:1}.page-hero{padding:85px 0 55px;border-bottom:1px solid var(--line)}.page-hero h1{font-size:clamp(54px,8vw,94px);max-width:900px;margin:16px 0 25px}.page-hero p{max-width:620px;color:var(--muted);font-size:15px;line-height:1.85}.about-story{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.about-story h2{font-size:clamp(36px,4vw,55px);margin:0}.about-story p{color:var(--muted);line-height:1.9;font-size:14px}.values{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:45px}.value{border-top:1px solid var(--line);padding-top:20px}.value strong{font:23px "Space Grotesk";display:block;margin-bottom:10px}.value p{font-size:12px;color:var(--muted);line-height:1.8}.service-list{display:grid;gap:14px}.service-row{display:grid;grid-template-columns:65px 1fr 1fr auto;align-items:center;gap:20px;padding:25px;border:1px solid var(--line);border-radius:20px;background:#ffffff04;transition:.3s}.service-row:hover{border-color:#b9f66b66;transform:translateX(4px)}.service-number{font:12px "DM Mono";color:var(--lime)}.service-row h3{font:22px "Space Grotesk";letter-spacing:-.04em;margin:0}.service-row p{font-size:12px;color:var(--muted);line-height:1.7;margin:0}.circle-arrow{height:42px;width:42px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;color:var(--lime)}.planner-layout{display:grid;grid-template-columns:1fr .88fr;gap:18px;align-items:start}.form-panel,.result-panel{border:1px solid var(--line);background:linear-gradient(145deg,#141e17,#0e1410);border-radius:24px;padding:28px}.panel-title{font:25px "Space Grotesk";letter-spacing:-.04em;margin:0 0 8px}.panel-sub{font-size:12px;color:var(--muted);line-height:1.7;margin:0 0 25px}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}.field.full{grid-column:1/-1}.field label{font-size:11px;color:#c7cec4;font-weight:600}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:12px;background:#0b110d;color:var(--text);padding:13px 14px;outline:none;font-size:12px;transition:border .2s}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--lime)}.field textarea{min-height:90px;resize:vertical}.field option{background:#111a14}.budget-number{font:clamp(32px,4vw,45px) "Space Grotesk";letter-spacing:-.06em;color:var(--lime);margin:4px 0 15px}.range{width:100%;accent-color:var(--lime);margin:10px 0 20px}.range-labels{display:flex;justify-content:space-between;font-size:10px;color:var(--muted)}.allocation{display:grid;gap:15px;margin-top:25px}.alloc-row{display:grid;grid-template-columns:110px 1fr 88px;gap:10px;align-items:center;font-size:11px}.alloc-track{height:7px;background:#ffffff12;border-radius:99px;overflow:hidden}.alloc-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#75b84e,var(--lime));transition:width .5s}.alloc-amount{text-align:right;font:11px "DM Mono";color:#e4e9df}.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}.kpi{padding:15px;border-radius:15px;background:#ffffff06;border:1px solid var(--line)}.kpi span{font-size:10px;color:var(--muted)}.kpi strong{display:block;font:21px "Space Grotesk";margin-top:7px}.notice{font-size:10px;line-height:1.7;color:#9aa59a;border-top:1px solid var(--line);padding-top:18px;margin-top:23px}.priority-list{display:grid;gap:11px;margin-top:24px}.priority{display:flex;gap:11px;align-items:flex-start;font-size:12px;line-height:1.6;color:#d4dbd1}.priority b{color:var(--lime);font:11px "DM Mono"}.resource-tools{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:26px}.filter{border:1px solid var(--line);border-radius:99px;background:transparent;color:#b4beb2;padding:10px 14px;font-size:11px}.filter.active,.filter:hover{background:var(--lime);color:#152016;border-color:var(--lime)}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.resource-card{border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#111813;transition:transform .3s,border-color .3s}.resource-card:hover{transform:translateY(-5px);border-color:#b9f66b55}.resource-art{height:170px;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 50%,#3a5d36,#18271b 40%,#0b100e 75%);display:grid;place-items:center}.resource-art:before{content:"";position:absolute;width:150px;height:150px;border:1px solid #b9f66b55;border-radius:50%;transform:rotateX(65deg);box-shadow:0 0 0 18px #b9f66b0c,0 0 0 38px #b9f66b0a}.resource-art .art-symbol{font:65px "Space Grotesk";color:var(--lime);text-shadow:0 0 40px #b9f66b55}.resource-body{padding:20px}.resource-meta{display:flex;justify-content:space-between;color:var(--lime);font:10px "DM Mono";margin-bottom:15px}.resource-body h3{font:21px "Space Grotesk";letter-spacing:-.04em;margin:0 0 10px}.resource-body p{font-size:12px;line-height:1.75;color:var(--muted);margin:0}.resource-read{margin-top:20px;border:0;background:none;padding:0;color:var(--lime);font-size:11px;font-weight:700}.consult-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:55px;align-items:start}.contact-item{display:flex;gap:13px;padding:18px 0;border-bottom:1px solid var(--line)}.contact-item .iconbox{margin:0;flex-shrink:0}.contact-item strong{font-size:13px;display:block;margin-bottom:5px}.contact-item span{font-size:11px;color:var(--muted);line-height:1.7}.success-message{display:none;padding:20px;border:1px solid #b9f66b55;background:#b9f66b10;border-radius:14px;color:var(--lime);font-size:13px;line-height:1.7;margin-top:18px}.success-message.show{display:block}.footer{border-top:1px solid var(--line);padding:48px 0 25px;margin-top:70px}.footer-top{display:flex;justify-content:space-between;gap:30px;padding-bottom:35px}.footer-brand p{max-width:300px;color:var(--muted);font-size:12px;line-height:1.8}.footer-links{display:flex;gap:45px}.footer-links div{display:grid;align-content:start;gap:13px}.footer-links strong{font:11px "DM Mono";color:var(--lime);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}.footer-links a{font-size:11px;color:var(--muted)}.footer-links a:hover{color:var(--text)}.footer-bottom{border-top:1px solid var(--line);padding-top:20px;display:flex;justify-content:space-between;color:#748073;font-size:10px}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--lime);color:#132014;border-radius:999px;padding:13px 18px;font-size:12px;font-weight:700;z-index:100;transition:.3s}.toast.show{opacity:1;transform:translate(-50%,0)}.modal{position:fixed;inset:0;background:#000b;backdrop-filter:blur(8px);display:none;place-items:center;padding:22px;z-index:90}.modal.open{display:grid}.modal-box{max-width:620px;width:100%;background:#121a15;border:1px solid var(--line);border-radius:24px;padding:30px;max-height:85vh;overflow:auto}.modal-head{display:flex;justify-content:space-between;gap:20px;align-items:start}.modal-head h3{font:30px "Space Grotesk";margin:0 0 15px}.close{background:none;color:white;border:1px solid var(--line);border-radius:50%;width:36px;height:36px;font-size:18px}.modal-box p,.modal-box li{font-size:13px;line-height:1.9;color:var(--muted)}.reveal{opacity:0;transform:translateY(22px);transition:opacity .75s ease,transform .75s ease}.reveal.visible{opacity:1;transform:none}
@media(max-width:900px){.navlinks{gap:15px}.navlinks a{font-size:11px}.hero{grid-template-columns:1fr .8fr;min-height:550px}.hero h1{font-size:clamp(56px,8vw,80px)}.visual{height:390px}.orb{width:280px}.split{gap:35px}.service-row{grid-template-columns:45px 1fr 1fr auto}.planner-layout{grid-template-columns:1fr}.result-panel{position:relative}.consult-layout{gap:28px}.resource-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.wrap,.nav-inner{width:calc(100% - 32px)}.nav{height:70px}.menu-btn{display:block}.navlinks{display:none;position:absolute;top:69px;left:0;right:0;background:#0d130f;border-bottom:1px solid var(--line);padding:18px 22px 22px;flex-direction:column;align-items:stretch;gap:0}.navlinks.open{display:flex}.navlinks a{padding:13px 0;font-size:13px;border-bottom:1px solid #ffffff0b}.navlinks .nav-cta{margin-top:14px}.hero{display:flex;flex-direction:column;align-items:stretch;padding:65px 0 45px;gap:10px}.hero h1{font-size:clamp(58px,16vw,85px)}.hero p{font-size:14px}.visual{height:340px;order:-1;margin-bottom:10px}.orb{width:230px}.label-a{top:30px;left:0}.label-b{right:0;top:125px}.label-c{bottom:15px;left:4%}.orbit-label{padding:10px 12px}.orbit-label strong{font-size:17px}.hero-bottom{align-items:flex-start;flex-direction:column}.metrics{gap:25px}.section{padding:70px 0}.section-head{display:block;margin-bottom:30px}.section-head p{margin-top:18px}.grid3,.grid2,.values,.about-story,.split,.consult-layout{grid-template-columns:1fr}.grid3{gap:12px}.card{padding:22px}.visual-panel{min-height:340px}.cta-band{padding:28px;display:block}.cta-band .btn{margin-top:14px}.page-hero{padding:60px 0 40px}.page-hero h1{font-size:clamp(52px,14vw,78px)}.service-row{grid-template-columns:34px 1fr auto;gap:12px;padding:19px}.service-row p{grid-column:2/4;grid-row:2}.service-row h3{font-size:19px}.service-row .circle-arrow{grid-column:3;grid-row:1}.field-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.form-panel,.result-panel{padding:21px}.resource-grid{grid-template-columns:1fr}.resource-art{height:190px}.footer-top{display:block}.footer-links{margin-top:30px;gap:30px;flex-wrap:wrap}.footer-bottom{gap:12px;flex-direction:column}.about-story{gap:15px}.values{gap:25px}.alloc-row{grid-template-columns:88px 1fr 78px}.section-head h2{font-size:43px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}
